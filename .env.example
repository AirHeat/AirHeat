# Browser/server authenticated client configuration (safe to expose only through the future build system)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only migration tooling. Never expose this variable to browser code or Vercel public env prefixes.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Required safeguards for a future staging import. The importer is dry-run unless --apply is passed.
AIRHEAT_IMPORT_TARGET=staging
AIRHEAT_IMPORT_CONFIRM=IMPORT_TO_STAGING_ONLY
